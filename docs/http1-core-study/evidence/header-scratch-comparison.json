  "summaries": {
    "on": "timers on trial 1\ntimers on trial 2\ntimers on trial 3\ntimers on trial 4\ntimers on trial 5\ntimers on trial 6\nsmall:client:continue: reduction=-1.4% CI=[-6.5, 2.9] base=1850.0ns candidate=1872.0ns\nsmall:client:yield: reduction=2.7% CI=[2.4, 2.9] base=1866.0ns candidate=1819.4ns\nsmall:server:continue: reduction=0.6% CI=[0.2, 1.0] base=2049.5ns candidate=2039.6ns\nsmall:server:yield: reduction=1.3% CI=[1.1, 1.5] base=2009.8ns candidate=1985.1ns\nchunked:client:continue: reduction=13.7% CI=[11.6, 15.7] base=51196.9ns candidate=43559.6ns\nchunked:client:yield: reduction=10.6% CI=[9.1, 12.3] base=50125.1ns candidate=45180.9ns\nchunked:server:continue: reduction=13.9% CI=[12.4, 15.6] base=51366.8ns candidate=44084.5ns\nchunked:server:yield: reduction=12.8% CI=[10.7, 14.6] base=53578.9ns candidate=45478.5ns\n",
