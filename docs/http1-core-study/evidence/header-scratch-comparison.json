  "comparison_script": "import itertools, json, math, random, re, statistics, subprocess, sys\nfrom pathlib import Path\nroot = Path(__file__).parent\nmode = sys.argv[1]\nrng = random.Random(1245)\ncases = list(itertools.product(['small', 'chunked'], ['client', 'server'], ['continue', 'yield']))\nresults = {':'.join(c): [] for c in cases}\nfor trial in range(6):\n    order = cases[:]\n    rng.shuffle(order)\n    for case in order:\n        pair = {}\n        for variant in (['base','candidate'] if trial % 2 == 0 else ['candidate','base']):\n            binary = (Path('/tmp/http1-selection-study') if variant == 'base' else root) / f'timers-{mode}'\n            output = subprocess.check_output(['taskset','-c','2',str(binary),*case,'1'],text=True,timeout=15)\n            pair[variant] = float(re.search(r'ns_per_exchange=([0-9.]+)',output)[1])\n            pair[variant+'_output'] = output.strip()\n        results[':'.join(case)].append(pair)\n        (root / f'comparison-{mode}.json').write_text(json.dumps(results,indent=2)+'\\n')\n    print('timers',mode,'trial',trial+1,flush=True)\nfor name, pairs in results.items():\n    logs=[math.log(p['candidate']/p['base']) for p in pairs]\n    ratios=sorted(math.exp(statistics.mean(rng.choices(logs,k=len(logs)))) for _ in range(10000))\n    saving=100*(1-math.exp(statistics.mean(logs)))\n    low,high=100*(1-ratios[9750]),100*(1-ratios[250])\n    print(f'{name}: reduction={saving:.1f}% CI=[{low:.1f}, {high:.1f}] base={statistics.median(p[\"base\"] for p in pairs):.1f}ns candidate={statistics.median(p[\"candidate\"] for p in pairs):.1f}ns',flush=True)\n",
  "probe_source": "#[path = \"/tmp/http1-transition-study/support.rs.original\"]\nmod support;\nuse std::{hint::black_box, time::{Duration, Instant}};\nuse support::{Endpoint, Scenario, Session};\n\nfn run<'a, M: Endpoint<'a>, const YIELD: bool>(mut session: Session<'a, M, YIELD, false>, seconds: u64) {\n    for _ in 0..100 { black_box(session.round_trip()); }\n    let begin = Instant::now();\n    let mut iterations = 0u64;\n    while begin.elapsed() < Duration::from_secs(seconds) {\n        for _ in 0..100 {\n            black_box(session.round_trip());\n        }\n        iterations += 100;\n    }\n    println!(\"iterations={iterations} elapsed_ns={} ns_per_exchange={:.2}\", begin.elapsed().as_nanos(), begin.elapsed().as_nanos() as f64 / iterations as f64);\n}\n\nfn main() {\n    let args: Vec<_> = std::env::args().collect();\n    let scenario = match args[1].as_str() {\n        \"small\" => Scenario::fixed(128),\n        \"fixed\" => Scenario::fixed(1024 * 1024),\n        \"chunked\" => Scenario::chunked(1024 * 1024, support::IO_BYTES),\n        _ => panic!(\"scenario\"),\n    };\n    let seconds = args.get(4).map(|s| s.parse().unwrap()).unwrap_or(5);\n    match (args[2].as_str(), args[3].as_str()) {\n        (\"client\", \"continue\") => {\n            support::client::<false, true>(&scenario).round_trip();\n            run(support::client::<false, false>(&scenario), seconds);\n        }\n        (\"server\", \"continue\") => {\n            support::server::<false, true>(&scenario).round_trip();\n            run(support::server::<false, false>(&scenario), seconds);\n        }\n        (\"client\", \"yield\") => {\n            support::client::<true, true>(&scenario).round_trip();\n            run(support::client::<true, false>(&scenario), seconds);\n        }\n        (\"server\", \"yield\") => {\n            support::server::<true, true>(&scenario).round_trip();\n            run(support::server::<true, false>(&scenario), seconds);\n        }\n        _ => panic!(\"role/mode\"),\n    }\n}\n",
  "method": "Six paired one-second trials per cell, CPU 2, alternating variant order and shuffled workloads. Geometric mean of paired ratios; nominal 95% paired-bootstrap intervals with 10000 resamples, no multiple-comparison adjustment. Validated simulated transport, 100 warmup exchanges, no profiling or counting allocator during timing. Timer-enabled support advances caller time by 1000 ns per drive turn.",
  "limits": "Small fixed 128 B and chunked 1 MiB (16 KiB chunks/buffers), both roles and callback modes. Shared-host core microbenchmark, not network throughput. Script/probe paths refer to session-local support copies; original raw profiles and binaries are not embedded. Candidate binaries precede a formatting-only edit."
}
